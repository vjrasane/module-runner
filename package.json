{
  "name": "module-runner",
  "version": "0.0.0-development",
  "main": "./dist/index.js",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./builtin": {
      "types": "./dist/builtin/index.d.ts",
      "default": "./dist/builtin/index.js"
    }
  },
  "bin": {
    "module-runner": "./dist/cli/module-runner.js",
    "module-runner-generate": "./dist/cli/generate.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx",
    "build": "tsup",
    "build:watch": "tsup --watch",
    "codegen": "tsx src/codegen/codegen-builtin.ts",
    "generate": "tsx src/codegen/generate.ts",
    "check:bootstrap": "tsx scripts/check-bootstrap.ts",
    "test": "vitest run",
    "prepublishOnly": "npm run check:bootstrap && npm run build"
  },
  "description": "Typed TypeScript bindings for running Ansible modules over a JSON-RPC server.",
  "keywords": [
    "ansible",
    "typescript",
    "automation",
    "infrastructure",
    "jsonrpc"
  ],
  "author": "Ville Räsänen <3148501+vjrasane@users.noreply.github.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vjrasane/module-runner.git"
  },
  "homepage": "https://github.com/vjrasane/module-runner#readme",
  "bugs": "https://github.com/vjrasane/module-runner/issues",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "semantic-release": "^25.0.9",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "ts-poet": "^6.12.0",
    "vscode-jsonrpc": "^10.0.0"
  }
}
